---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Muhammad Rafly Wirayudha — Frontend Developer",
  description = "Portfolio of Muhammad Rafly Wirayudha, a passionate frontend developer specializing in performance-driven web applications with a bold neobrutalist aesthetic.",
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/profil.png" />
    <meta name="theme-color" content="#f8faff" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%232B4EFF'/><text x='50' y='68' font-size='60' font-family='monospace' font-weight='bold' text-anchor='middle' fill='white'>&lt;/&gt;</text></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-background text-on-surface min-h-screen flex flex-col overflow-x-hidden font-headline selection:bg-primary selection:text-on-primary"
  >
    <slot />
  </body>
</html>
