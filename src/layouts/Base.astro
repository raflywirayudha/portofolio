---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Muhammad Rafly Wirayudha — Portofolio",
  description = "Portofolio Muhammad Rafly Wirayudha — frontend developer dan cybersecurity enthusiast. Kumpulan proyek, pengalaman, dan sertifikasi.",
} = Astro.props;

const siteURL = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const socialImageURL = new URL("/profil.png", siteURL);
const siteRoot = new URL("/", siteURL).href;

// Structured data: membantu Google memahami nama situs, halaman, dan pemiliknya.
// Catatan: `jobTitle` sengaja tidak diisi "Frontend Developer" agar tidak
// memperkuat frasa itu sebagai judul di hasil pencarian.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteRoot}#website`,
      url: siteRoot,
      name: "Muhammad Rafly Wirayudha",
      alternateName: ["Portofolio", "Portfolio", "Rafly Wirayudha"],
      inLanguage: "id",
      publisher: { "@id": `${siteRoot}#person` },
    },
    {
      "@type": "Person",
      "@id": `${siteRoot}#person`,
      name: "Muhammad Rafly Wirayudha",
      url: siteRoot,
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "UIN Sultan Syarif Kasim Riau",
      },
      knowsAbout: ["Frontend Development", "Cybersecurity"],
      sameAs: [
        "https://github.com/raflywirayudha",
        "https://www.linkedin.com/in/muhammadraflywirayudha/",
        "https://www.instagram.com/raflywirayudhaa/",
      ],
    },
    {
      "@type": "ProfilePage",
      "@id": `${siteRoot}#webpage`,
      url: siteRoot,
      name: title,
      inLanguage: "id",
      mainEntity: { "@id": `${siteRoot}#person` },
    },
  ],
};
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="google-site-verification"
      content="U47LUhD9ajoyDeGiQgcIu8-3Kb5zoZzz56VP8hkCv4w"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Muhammad Rafly Wirayudha" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={socialImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="theme-color" content="#f8faff" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <!-- Favicons (favicon.io) — file ada di public/favicon_io/
         Naikkan ?v= setiap mengganti ikon agar cache favicon browser ter-refresh. -->
    <link rel="icon" href="/favicon_io/favicon.ico?v=3" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon_io/favicon-32x32.png?v=3"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon_io/favicon-16x16.png?v=3"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon_io/apple-touch-icon.png?v=3"
    />
    <link rel="manifest" href="/site.webmanifest?v=3" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-background text-on-surface min-h-screen flex flex-col overflow-x-hidden font-headline selection:bg-primary selection:text-on-primary"
  >
    <slot />

    <script>
      // Reveal saat elemen masuk viewport (sekali saja per elemen).
      const revealElements =
        document.querySelectorAll<HTMLElement>("[data-reveal]");

      if (revealElements.length > 0) {
        if (!("IntersectionObserver" in window)) {
          revealElements.forEach((el) => el.classList.add("is-visible"));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;

                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              });
            },
            { rootMargin: "0px 0px -10% 0px", threshold: 0 },
          );

          revealElements.forEach((el) => observer.observe(el));
        }
      }
    </script>
  </body>
</html>
