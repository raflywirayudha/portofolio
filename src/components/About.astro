---
import SectionHeader from "./SectionHeader.astro";

const paragraphs = [
  "Saya Muhammad Rafly Wirayudha. Sebagai seorang fresh graduate Teknik Informatika dari UIN Sultan Syarif Kasim Riau, saya memiliki ketertarikan yang mendalam terhadap dunia teknologi, khususnya pada keamanan digital.",
  "Saya memiliki semangat belajar yang tinggi dan sedang aktif mempertajam skill. Saya sangat antusias untuk membawa energi dan dedikasi ini ke dalam peran entry-level di bidang cybersecurity, di mana saya bisa berkontribusi nyata sekaligus terus berkembang.",
];

const strip = Array.from({ length: 60 }, () => "0").join(" ");

const paperTags = [
  { label: "XGBoost ML", class: "bg-[#ddd6fe]" },
  { label: "PhishTank Live Feeds", class: "bg-accent-lime" },
  { label: "Tranco Rank API", class: "bg-accent-yellow" },
  { label: "Chrome Manifest V3", class: "bg-surface" },
];

const toolchain = [
  "React.js",
  "TypeScript",
  "Tailwind CSS",
  "Python",
  "Wireshark",
  "Burp Suite",
  "Nmap",
  "Linux CLI",
];
---

<section
  id="about"
  class="relative flex w-full flex-col gap-8 border-t-[3px] border-outline bg-[#4d17ed] checker-purple-sm px-margin-mobile py-12 md:px-margin-desktop md:py-20"
>
  <SectionHeader label="about_me" title="About Me" />
  <div
    class="mx-auto grid w-full max-w-7xl grid-cols-1 items-start gap-8 lg:grid-cols-12"
  >
    <!-- Kolom kiri: narasi + paper -->
    <div class="relative lg:col-span-7" data-reveal="up">
      <!-- Strip barcode di tepi atas kartu -->
      <div
        class="absolute -top-3.5 right-6 z-10 max-w-[calc(100%_-_3rem)] overflow-hidden whitespace-nowrap border-2 border-outline bg-gray-400 px-3 py-1 font-label-mono text-[10px] font-black uppercase tracking-[0.18em] text-white shadow-[2px_2px_0_0_#0a0612]"
        aria-hidden="true"
      >
        {strip}
      </div>

      <div
        class="relative flex flex-col gap-6 border-[4px] border-outline bg-accent-lavender p-6 shadow-[8px_8px_0_0_#0a0612] sm:p-8"
      >
        <div class="flex flex-col gap-4">
          <p class="text-[15px] font-bold leading-none">Halo</p>
          {
            paragraphs.map((paragraph) => (
              <p class="text-[15px] font-medium leading-relaxed text-on-surface/90 sm:text-[16px]">
                {paragraph}
              </p>
            ))
          }
        </div>

        <!-- Kartu paper -->
        <a
          href="https://everant.org/index.php/etj/article/view/2841"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 block border-[3px] border-outline bg-surface p-4 shadow-[6px_6px_0_0_#0a0612] transition-neobrutal hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[3px_3px_0_0_#0a0612] focus:outline-none focus-visible:ring-4 focus-visible:ring-primary sm:p-5"
        >
          <p
            class="mb-2 flex items-center gap-2 font-label-mono text-[12px] font-black uppercase tracking-wider text-[#5b21b6]"
          >
            <span aria-hidden="true">✦</span> Paper
          </p>
          <p
            class="font-label-mono text-[13px] font-bold leading-snug text-on-surface sm:text-[14px]"
          >
            “Implementation of a Browser Extension with Multi-Layer Security
            Filtering Architecture for Real-Time Phishing Website Detection”
          </p>
          <div
            class="mt-3 flex flex-wrap gap-2 font-label-mono text-[11px] font-bold"
          >
            {
              paperTags.map((tag) => (
                <span
                  class:list={["border border-outline px-2 py-0.5", tag.class]}
                >
                  {tag.label}
                </span>
              ))
            }
          </div>
        </a>
      </div>
    </div>

    <!-- Kolom kanan: metrik, filosofi, toolchain -->
    <div class="flex flex-col gap-5 lg:col-span-5">
      <!-- GPA -->
      <div
        class="relative overflow-hidden border-[4px] border-outline bg-accent-yellow p-6 shadow-[8px_8px_0_0_#0a0612]"
        data-reveal="up"
        style="--reveal-delay: 100ms"
      >
        <div
          class="pointer-events-none absolute -right-5 -bottom-8 select-none font-label-mono text-[110px] font-black leading-none text-on-surface/10 sm:text-[132px]"
          aria-hidden="true"
        >
          3.70
        </div>
        <p
          class="relative font-label-mono text-[12px] font-black uppercase tracking-[0.2em] text-on-surface"
        >
          Cum Laude
        </p>
        <p
          class="relative mt-2 flex items-baseline gap-2 font-black tracking-tight text-on-surface"
        >
          <span class="text-[46px] leading-none sm:text-[56px]">3.70</span>
          <span class="font-label-mono text-[18px] leading-none sm:text-[20px]">
            / 4.00
          </span>
        </p>
      </div>

      <!-- Filosofi -->
      <div
        class="border-[4px] border-outline bg-surface p-6 shadow-[8px_8px_0_0_#0a0612]"
        data-reveal="up"
        style="--reveal-delay: 180ms"
      >
        <div class="mb-3 flex items-center gap-2.5">
          <span
            class="h-3.5 w-3.5 shrink-0 border-2 border-outline bg-[#5b21b6]"
            aria-hidden="true"></span>
          <span
            class="font-label-mono text-[12px] font-black uppercase tracking-[0.16em] text-[#5b21b6]"
          >
            Engineering Philosophy
          </span>
        </div>
        <blockquote
          class="border-l-4 border-[#5b21b6] pl-4 text-[17px] font-black italic leading-snug text-on-surface sm:text-[19px]"
        >
          “Learn security by dissecting living systems; build software by
          anticipating real-world threats from Day 0.”
        </blockquote>
      </div>

      <!-- Toolchain -->
      <div
        class="border-[3px] border-outline bg-accent-lavender p-5 shadow-[6px_6px_0_0_#0a0612]"
        data-reveal="up"
        style="--reveal-delay: 260ms"
      >
        <p
          class="mb-3 font-label-mono text-[12px] font-black uppercase tracking-wider text-on-surface"
        >
          Core Toolchain
        </p>
        <div class="flex flex-wrap gap-2 font-label-mono text-[11px] font-bold">
          {
            toolchain.map((tool) => (
              <span class="border-2 border-outline bg-surface px-2 py-1">
                {tool}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
