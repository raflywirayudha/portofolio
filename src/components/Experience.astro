---
import SectionHeader from "./SectionHeader.astro";
import InfoCard from "./InfoCard.astro";
import { experience } from "../data/experience";
---

<section
  id="experience"
  class="w-full flex flex-col gap-8 border-t-[3px] border-outline py-10 px-margin-mobile md:px-margin-desktop diagonal-stripes"
>
  <SectionHeader label="experience" title="Work History" />
  <div class="flex flex-col gap-10 py-4">
    {
      experience.map((job, index) => (
        <InfoCard
          period={job.period}
          periodNote={job.periodNote}
          title={job.role}
          subtitle={job.company}
          tag={job.tag}
          sectionLabel="Key Responsibilities & Deliverables"
          description={job.description}
          highlights={job.highlights}
          colorOffset={index}
        />
      ))
    }
  </div>
</section>
