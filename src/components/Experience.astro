---
import SectionHeader from "./SectionHeader.astro";
import { experience } from "../data/experience";
---

<section
  id="experience"
  class="w-full flex flex-col gap-8 border-t-[3px] border-outline py-10 px-margin-mobile md:px-margin-desktop bg-surface"
>
  <SectionHeader label="experience" title="Work History" />
  <div
    class="relative border-l-[3px] border-outline ml-4 md:ml-8 flex flex-col gap-6 py-8 mt-4"
  >
    {
      experience.map((job) => (
        <div class="relative">
          <div
            class="absolute -left-[9px] top-6 w-6 h-6 bg-primary brutal-border brutal-shadow"
            aria-hidden="true"
          />
          <div class="ml-8 md:ml-12 bg-background brutal-border brutal-shadow p-8 flex flex-col gap-2">
            <div class="flex flex-col md:flex-row md:justify-between md:items-baseline gap-2 mb-2">
              <h3 class="text-[24px] font-black uppercase text-on-surface">
                {job.role}
              </h3>
              <span class="font-label-mono text-label-mono bg-background text-on-surface brutal-border px-2 py-1 inline-block self-start">
                {job.period}
              </span>
            </div>
            <h4 class="font-label-mono text-[14px] uppercase mb-4 border-b-[2px] border-outline inline-block pb-1 text-on-surface-variant">
              {job.company}
            </h4>
            <p class="text-body-md text-on-surface-variant max-w-3xl">
              {job.description}
            </p>
            {job.highlights && (
              <ul class="mt-1 flex max-w-3xl flex-col gap-2.5">
                {job.highlights.map((highlight) => (
                  <li class="flex gap-2.5">
                    <span
                      class="mt-[10px] h-2.5 w-2.5 shrink-0 border-[3px] border-outline bg-primary"
                      aria-hidden="true"
                    />
                    <p class="text-body-md text-on-surface-variant">
                      {highlight}
                    </p>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>
