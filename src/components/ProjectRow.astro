---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
  /** URL gambar ukuran besar untuk lightbox */
  fullSrc: string;
  fullSecondarySrc?: string;
}

const { project, index, fullSrc, fullSecondarySrc } = Astro.props;

const number = String(index).padStart(2, "0");
const accentClass =
  project.accent === "amber" ? "bg-accent-amber" : "bg-accent-lime";
---

<article class="relative bg-surface brutal-border brutal-shadow" data-reveal="up">
  <div
    class="flex flex-col gap-7 p-5 sm:p-7 lg:grid lg:grid-cols-[3fr_2fr] lg:items-center lg:gap-10 lg:p-9"
  >
    <!-- Kolom kiri: badge + teks. Di mobile wrapper ini dipecah (display: contents)
         supaya badge, gambar, lalu judul bisa diurutkan ulang. -->
    <div class="contents min-w-0 lg:flex lg:flex-col lg:gap-4">
      <!-- Badge baris atas -->
      <div class="order-1 flex flex-wrap items-center gap-x-3 gap-y-2">
        <span
          class="bg-primary px-2 py-1 font-label-mono text-[10px] font-bold uppercase tracking-[0.12em] text-on-primary"
        >
          Project {number}
        </span>
        {
          project.category && (
            <span
              class:list={[
                accentClass,
                "border-2 border-outline px-2 py-1 font-label-mono text-[10px] font-bold uppercase tracking-[0.12em] text-on-surface",
              ]}
            >
              {project.category}
            </span>
          )
        }
        <span
          class="flex flex-wrap items-center gap-2 font-label-mono text-[10px] font-bold uppercase tracking-[0.12em] text-on-surface-variant/70"
        >
          <span>{project.year}</span>
          {project.kind && <span aria-hidden="true">·</span>}
          {project.kind && <span>{project.kind}</span>}
        </span>
      </div>

      <!-- Judul + isi -->
      <div class="order-3 flex min-w-0 flex-col gap-4">
        <h3
          class="text-[28px] font-black uppercase leading-[1.02] tracking-tight text-on-surface sm:text-[34px] lg:text-[44px]"
        >
          {project.title}
        </h3>

        <p class="max-w-[62ch] text-[14px] leading-relaxed text-on-surface-variant md:text-[15px] lg:text-[16px]">
          {project.description}
        </p>

        <div class="mt-1 flex flex-wrap gap-2">
          {
            project.tags.map((tag) => (
              <span class="border-2 border-outline bg-surface px-2 py-1 font-label-mono text-[10px] font-bold uppercase text-on-surface">
                {tag}
              </span>
            ))
          }
        </div>

        {
          project.repo && (
            <div class="mt-2">
              <a
                href={project.repo}
                target={project.repo === "#" ? undefined : "_blank"}
                rel="noreferrer"
                class="inline-flex items-center justify-center gap-2 border-[3px] border-outline bg-primary px-5 py-2.5 font-label-mono text-[11px] font-bold uppercase text-on-primary brutal-shadow-sm transition-neobrutal brutal-hover"
              >
                <span
                  class="material-symbols-outlined text-[18px]"
                  aria-hidden="true"
                >
                  code
                </span>
                Code
              </a>
            </div>
          )
        }
      </div>
    </div>

    <!-- ===== Screenshot ===== -->
    <div
      class:list={[
        "relative order-2 min-w-0 lg:order-none",
        project.secondaryImage && "lg:pb-10",
      ]}
      data-reveal="pop"
      style="--reveal-delay: 120ms"
    >
      <button
        type="button"
        data-lightbox-src={fullSrc}
        data-lightbox-alt={project.imageAlt}
        data-lightbox-title={project.title}
        data-lightbox-meta={`${project.kind ?? project.category ?? ""} — ${project.year}`}
        class="group block w-full cursor-zoom-in border-[3px] border-outline bg-surface text-left shadow-[7px_7px_0_0_#000] transition-neobrutal hover:translate-x-1 hover:translate-y-1 hover:shadow-[3px_3px_0_0_#000] focus:outline-none focus-visible:ring-4 focus-visible:ring-primary"
        aria-label={`Perbesar screenshot ${project.title}`}
      >
        <!-- Frame browser palsu — menyatukan semua screenshot -->
        {
          !project.hasOwnBrowserChrome && (
            <div class="flex items-center gap-2 border-b-[3px] border-outline bg-surface px-3 py-2">
              <span class="h-2.5 w-2.5 rounded-full border-2 border-outline bg-error-container" />
              <span class="h-2.5 w-2.5 rounded-full border-2 border-outline bg-tertiary-fixed-dim" />
              <span class="h-2.5 w-2.5 rounded-full border-2 border-outline bg-primary" />
            </div>
          )
        }
        <div class="relative overflow-hidden bg-surface-container-high">
          <Image
            src={project.image}
            alt={project.imageAlt}
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 1024px) 34vw, 100vw"
            format="webp"
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />
        </div>
      </button>

      <!-- Screenshot kedua (mis. Koki Akhir Bulan: landing + chatbot) -->
      {
        project.secondaryImage && fullSecondarySrc && (
          <div class="relative z-20 mt-5 w-full lg:absolute lg:-bottom-2 lg:-left-6 lg:mt-0 lg:w-[58%] lg:rotate-2">
            <button
              type="button"
              data-lightbox-src={fullSecondarySrc}
              data-lightbox-alt={project.secondaryImageAlt ?? project.imageAlt}
              data-lightbox-title={`${project.title} — Detail`}
              data-lightbox-meta={`${project.kind ?? project.category ?? ""} — ${project.year}`}
              class="group block w-full cursor-zoom-in border-[3px] border-outline bg-surface text-left shadow-[7px_7px_0_0_#000] transition-neobrutal hover:translate-x-1 hover:translate-y-1 hover:shadow-[3px_3px_0_0_#000] focus:outline-none focus-visible:ring-4 focus-visible:ring-primary"
              aria-label={`Perbesar screenshot detail ${project.title}`}
            >
              <div class="relative overflow-hidden bg-surface-container-high">
                <Image
                  src={project.secondaryImage}
                  alt={project.secondaryImageAlt ?? ""}
                  widths={[320, 480, 720]}
                  sizes="(min-width: 1024px) 22vw, 100vw"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-full"
                />
              </div>
            </button>
          </div>
        )
      }
    </div>
  </div>
</article>
