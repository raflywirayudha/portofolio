---
const name = "Muhammad Rafly Wirayudha";
const role = "Informatics Engineering";
const photo = "/profil.png";
---

<section
  id="hero"
  class="w-full min-h-[91dvh] lg:h-[91dvh] py-10 px-margin-mobile md:px-margin-desktop flex flex-col items-center text-center lg:items-stretch lg:text-left justify-center gap-5 lg:gap-6 relative bg-background blueprint-grid"
>
  <!-- Foto (mobile/tablet): mengikuti komposisi desktop, ukuran diperkecil -->
  <div class="relative z-20 mx-auto shrink-0 mb-5 lg:hidden" data-reveal="pop">
    <div class="relative w-[min(62vw,235px)]">
      <!-- Lingkaran dekoratif: sudut kiri atas seperti di desktop -->
      <div
        class="shape-float absolute -left-9 -top-7 z-20 h-18 w-18 rotate-12 rounded-full border-[3px] border-outline bg-primary brutal-shadow-sm"
        style="--float-y: -8px; --float-duration: 6.5s; --float-delay: 0s"
        aria-hidden="true"
      >
      </div>
      <!-- Persegi dekoratif: sisi kanan, sepertiga atas -->
      <div
        class="shape-float absolute -right-7 top-16 z-20 h-14 w-14 rotate-12 border-[3px] border-outline bg-primary brutal-shadow-sm"
        style="--float-y: -6px; --float-duration: 7.5s; --float-delay: 1.2s"
        aria-hidden="true"
      >
      </div>
      <!-- Balok dekoratif: kanan bawah -->
      <div
        class="shape-float absolute -bottom-4 -right-3 z-20 h-8 w-26 rotate-3 border-[3px] border-outline bg-primary brutal-shadow-sm"
        style="--float-y: -5px; --float-duration: 8s; --float-delay: 2.1s"
        aria-hidden="true"
      >
      </div>
      <!-- Persegi membulat dekoratif: kiri bawah -->
      <div
        class="shape-float absolute -left-7 bottom-8 z-20 h-11 w-17 -rotate-12 rounded-xl border-[3px] border-outline bg-primary"
        style="--float-y: -7px; --float-duration: 6s; --float-delay: 0.6s"
        aria-hidden="true"
      >
      </div>

      <!-- Kartu utama: dot-grid + sudut membulat seperti desktop -->
      <div
        class="dot-grid brutal-border brutal-shadow relative z-10 aspect-square w-full overflow-hidden rounded-se-4xl rounded-es-4xl bg-surface -rotate-1"
      >
        <picture>
          <source srcset="/profil.webp" type="image/webp" />
          <img
            alt={name}
            src={photo}
            width="420"
            height="420"
            fetchpriority="high"
            class="relative z-10 h-full w-full object-cover object-top contrast-125"
          />
        </picture>
      </div>
    </div>
  </div>

  <!-- Label kecil (mobile/tablet) -->
  <p
    class="relative z-20 flex items-center justify-center gap-2 font-label-mono text-[11px] font-bold uppercase tracking-[0.16em] text-on-surface-variant lg:hidden"
    data-reveal="up"
    style="--reveal-delay: 80ms"
  >
    <span
      class="h-2.5 w-2.5 shrink-0 rounded-full bg-primary"
      aria-hidden="true"></span>
    Frontend Developer / Cybersecurity
  </p>

  <h1
    class="text-hero-title-mobile md:text-hero-title font-black uppercase max-w-4xl leading-[1.05] md:leading-tight text-on-surface relative z-20"
    data-reveal="up"
    style="--reveal-delay: 140ms"
  >
    {name}
    <br />
    <span
      class="bg-primary text-[18px] leading-[1.15] sm:text-5xl text-on-primary px-3 sm:px-4 whitespace-nowrap sm:whitespace-normal sm:py-1 py-2 inline-block -rotate-1 brutal-border brutal-shadow mt-3 sm:mt-2"
    >
      {role}
    </span>
  </h1>

  <!-- Deskripsi singkat (mobile/tablet) -->
  <!-- <p
    class="relative z-20 max-w-[36ch] text-[15px] leading-relaxed text-on-surface-variant lg:hidden"
  >
    Fresh graduate Teknik Informatika yang fokus pada pengembangan antarmuka web
    dan keamanan siber.
  </p> -->

  <div
    class="flex w-full flex-col sm:flex-row gap-3 sm:gap-6 mt-1 lg:mt-8 lg:w-auto relative z-20"
    data-reveal="up"
    style="--reveal-delay: 220ms"
  >
    <a
      href="#projects"
      class="bg-primary text-on-primary px-8 py-4 brutal-border brutal-shadow transition-neobrutal brutal-hover font-label-mono text-label-mono uppercase text-center flex items-center justify-center gap-2 whitespace-nowrap"
    >
      LIHAT PROYEK
      <span class="material-symbols-outlined text-[18px]" aria-hidden="true">
        arrow_forward
      </span>
    </a>
    <a
      id="cv-trigger"
      href="/cv_muhammad-rafly-wirayudha.pdf"
      target="_blank"
      rel="noopener noreferrer"
      aria-haspopup="dialog"
      class="bg-surface text-on-surface px-8 py-4 brutal-border brutal-shadow transition-neobrutal brutal-hover font-label-mono text-label-mono uppercase text-center flex items-center justify-center gap-2 whitespace-nowrap"
    >
      LIHAT CV
      <span class="material-symbols-outlined text-[18px]" aria-hidden="true">
        visibility
      </span>
    </a>
  </div>

  <!-- Photo Card Container -->
  <div
    class="hidden lg:block absolute right-40 top-40 w-[420px] h-[520px] z-10 translate-x-4 -translate-y-12 rotate-2"
    data-reveal="pop"
    style="--reveal-delay: 120ms"
  >
    <!-- Decorative Circle -->
    <div
      class="shape-float hidden lg:block absolute right-[340px] top-[-40px] w-32 h-32 rounded-full bg-primary border-[3px] border-outline brutal-shadow z-30 rotate-12"
      style="--float-y: -8px; --float-duration: 6.5s; --float-delay: 0s"
      aria-hidden="true"
    >
    </div>

    <!-- Decorative Square -->
    <div
      class="shape-float hidden lg:block absolute left-[370px] top-[150px] w-26 h-26 bg-primary border-[3px] border-outline brutal-shadow z-30 rotate-12"
      style="--float-y: -6px; --float-duration: 7.5s; --float-delay: 1.2s"
      aria-hidden="true"
    >
    </div>

    <!-- Decorative Triangle -->
    <div
      class="shape-float absolute -left-12 bottom-12 w-24 h-16 bg-primary border-[3px] rounded-2xl border-outline brutal-shadow z-30 -rotate-20"
      style="--float-y: -7px; --float-duration: 6s; --float-delay: 0.6s"
      aria-hidden="true"
    >
    </div>
    <!-- Main Card -->
    <div
      class="w-full h-full bg-surface brutal-border brutal-shadow dot-grid relative overflow-hidden flex items-center justify-center rounded-se-4xl rounded-es-4xl"
    >
      <picture>
        <source srcset="/profil.webp" type="image/webp" />
        <img
          alt={name}
          src={photo}
          width="420"
          height="520"
          fetchpriority="high"
          class="w-full h-full object-cover contrast-125 grayscale hover:grayscale-0 transition-all duration-300 relative z-10"
        />
      </picture>
    </div>
    <!-- Decorative Rectangle -->
    <div
      class="shape-float absolute -right-8 -bottom-4 w-48 h-12 bg-primary border-[3px] border-outline brutal-shadow z-30 rotate-3"
      style="--float-y: -5px; --float-duration: 8s; --float-delay: 2.1s"
      aria-hidden="true"
    >
    </div>
  </div>
</section>

<dialog
  id="cv-dialog"
  aria-labelledby="cv-dialog-title"
  class="w-[min(94vw,72rem)] max-w-none h-[92dvh] max-h-[92dvh] p-0 m-auto bg-surface brutal-border brutal-shadow text-on-surface backdrop:bg-black/80"
>
  <div class="flex h-full flex-col">
    <div
      class="flex flex-col gap-3 border-b-[3px] border-outline bg-background px-5 py-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4"
    >
      <div class="flex min-w-0 flex-col gap-1">
        <span
          class="font-label-mono text-[11px] font-bold uppercase text-on-surface-variant"
        >
          Curriculum Vitae
        </span>
        <h2
          id="cv-dialog-title"
          class="text-[17px] font-black uppercase leading-tight md:text-[22px]"
        >
          Muhammad Rafly Wirayudha
        </h2>
      </div>

      <div class="flex shrink-0 items-center gap-2">
        <a
          id="cv-dialog-download"
          href="/cv_muhammad-rafly-wirayudha.pdf"
          download="cv_muhammad-rafly-wirayudha.pdf"
          class="bg-primary text-on-primary brutal-border brutal-shadow-sm brutal-hover transition-neobrutal px-3 py-1 font-label-mono text-[11px] font-bold uppercase"
        >
          Unduh
        </a>
        <a
          id="cv-dialog-newtab"
          href="/cv_muhammad-rafly-wirayudha.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden bg-surface brutal-border brutal-shadow-sm brutal-hover transition-neobrutal px-3 py-1 font-label-mono text-[11px] font-bold uppercase sm:block"
        >
          Tab Baru
        </a>
        <button
          type="button"
          id="cv-dialog-close"
          class="shrink-0 cursor-pointer bg-surface brutal-border brutal-shadow-sm brutal-hover transition-neobrutal px-3 py-1 font-label-mono text-[11px] font-bold uppercase"
        >
          Tutup
        </button>
      </div>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto bg-surface-container-high p-3 md:p-4">
      <iframe
        id="cv-dialog-frame"
        title="Pratinjau CV Muhammad Rafly Wirayudha"
        class="hidden h-full w-full bg-surface brutal-border"
      ></iframe>

      <div id="cv-dialog-fallback" class="hidden h-full">
        <div
          class="flex h-full flex-col items-center justify-center gap-4 px-2 py-8 text-center"
        >
          <span
            class="material-symbols-outlined text-[40px] text-on-surface-variant"
            aria-hidden="true"
          >
            description
          </span>
          <p
            class="font-label-mono text-[11px] font-bold uppercase text-on-surface-variant"
          >
            Browser ini belum mendukung pratinjau PDF langsung
          </p>
          <p class="max-w-[42ch] text-[15px] leading-relaxed text-on-surface">
            Buka CV di tab baru atau unduh filenya untuk melihat isinya.
          </p>
          <div class="flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
            <a
              id="cv-dialog-fallback-open"
              href="/cv_muhammad-rafly-wirayudha.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-primary text-on-primary px-6 py-3 brutal-border brutal-shadow transition-neobrutal brutal-hover font-label-mono text-label-mono uppercase text-center flex items-center justify-center gap-2"
            >
              Buka CV
              <span
                class="material-symbols-outlined text-[18px]"
                aria-hidden="true">open_in_new</span
              >
            </a>
            <a
              id="cv-dialog-fallback-download"
              href="/cv_muhammad-rafly-wirayudha.pdf"
              download="cv_muhammad-rafly-wirayudha.pdf"
              class="bg-surface text-on-surface px-6 py-3 brutal-border brutal-shadow transition-neobrutal brutal-hover font-label-mono text-label-mono uppercase text-center flex items-center justify-center gap-2"
            >
              Unduh CV
              <span
                class="material-symbols-outlined text-[18px]"
                aria-hidden="true">download</span
              >
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  // Pause animasi shape saat Hero tidak terlihat (hemat CPU/baterai)
  const hero = document.getElementById("hero");
  const heroShapes = hero?.querySelectorAll<HTMLElement>(".shape-float");

  if (hero && heroShapes && heroShapes.length > 0) {
    const shapeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          hero.classList.toggle("shapes-paused", !entry.isIntersecting);
        });
      },
      { threshold: 0 },
    );

    shapeObserver.observe(hero);
  }

  // ==== Pratinjau CV (dialog) ====
  const cvTrigger = document.getElementById("cv-trigger");
  const cvDialog = document.getElementById(
    "cv-dialog",
  ) as HTMLDialogElement | null;
  const cvFrame = document.getElementById(
    "cv-dialog-frame",
  ) as HTMLIFrameElement | null;
  const cvFallback = document.getElementById("cv-dialog-fallback");
  const cvDownload = document.getElementById(
    "cv-dialog-download",
  ) as HTMLAnchorElement | null;
  const cvNewTab = document.getElementById(
    "cv-dialog-newtab",
  ) as HTMLAnchorElement | null;
  const cvClose = document.getElementById("cv-dialog-close");

  if (cvTrigger && cvDialog && cvFrame && cvFallback) {
    const cvUrl = cvTrigger.getAttribute("href") ?? "";

    // Sinkronkan tautan unduh/buka supaya sumbernya tetap satu (href tombol hero)
    cvDownload?.setAttribute("href", cvUrl);
    cvNewTab?.setAttribute("href", cvUrl);

    // iOS/iPadOS tidak mendukung pratinjau PDF inline di iframe
    const isIOS =
      /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.maxTouchPoints > 1 && /Macintosh/.test(navigator.userAgent));
    const canEmbedPdf =
      !isIOS &&
      (navigator as Navigator & { pdfViewerEnabled?: boolean })
        .pdfViewerEnabled !== false;

    const openCvDialog = () => {
      if (canEmbedPdf && !cvFrame.getAttribute("src")) {
        cvFrame.src = `${cvUrl}#view=FitH&navpanes=0&toolbar=1`;
      }

      cvFrame.classList.toggle("hidden", !canEmbedPdf);
      cvFallback.classList.toggle("hidden", canEmbedPdf);

      cvDialog.showModal();
    };

    cvTrigger.addEventListener("click", (event) => {
      // Biarkan perilaku bawaan (buka tab baru) bila JS gagal
      event.preventDefault();
      openCvDialog();
    });

    cvClose?.addEventListener("click", () => cvDialog.close());

    // Tutup saat klik area gelap di luar panel
    cvDialog.addEventListener("click", (event) => {
      if (event.target !== cvDialog) return;

      const rect = cvDialog.getBoundingClientRect();
      const isInsidePanel =
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom;

      if (!isInsidePanel) cvDialog.close();
    });
  }
</script>
