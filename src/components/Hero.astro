---
const name = "Muhammad Rafly Wirayudha";
const role = "Informatics Engineering";
const photo = "/profil.png";
---

<section
  id="hero"
  class="w-full min-h-[91dvh] py-10 lg:py-16 px-margin-mobile md:px-margin-desktop flex flex-col items-center text-center justify-center gap-5 relative overflow-hidden bg-hero-canvas lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-x-12 xl:gap-x-16"
>
  <!-- Halftone mesh dari code.html -->
  <div
    class="pointer-events-none absolute left-0 top-0 z-0 h-[34%] w-[68%] opacity-30 halftone-top-left sm:h-[530px] sm:w-[650px] sm:opacity-40"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute bottom-0 right-0 z-0 h-[36%] w-[72%] opacity-25 halftone-bottom-right sm:h-[590px] sm:w-[710px] sm:opacity-35"
    aria-hidden="true"
  >
  </div>
  <!-- Lingkaran dekoratif di belakang judul -->
  <div
    class="pointer-events-none absolute left-[27%] top-[4%] hidden h-[280px] w-[280px] rounded-full border border-primary/30 lg:block"
    aria-hidden="true"
  >
    <div class="absolute inset-12 rounded-full border border-primary/25"></div>
    <div class="absolute inset-24 rounded-full border border-primary/20"></div>
  </div>
  <!-- Bintang dekoratif di antara kolom teks dan foto -->
  <svg
    class="pointer-events-none absolute left-[47%] top-[12%] hidden h-8 w-8 text-primary lg:block"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z"></path>
  </svg>
  <!-- Bintang ungu tambahan -->
  <svg
    class="pointer-events-none absolute right-[7%] top-[6%] h-5 w-5 text-primary/80 lg:h-6 lg:w-6"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z"></path>
  </svg>
  <svg
    class="pointer-events-none absolute left-[34%] top-[7%] hidden h-4 w-4 text-primary/80 lg:block"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z"></path>
  </svg>
  <svg
    class="pointer-events-none absolute left-[21%] top-[26%] hidden h-5 w-5 text-primary/70 lg:block"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z"></path>
  </svg>

  <!-- Kartu foto: satu blok responsif (square di mobile, portrait di desktop) -->
  <div
    class="relative z-20 mx-auto shrink-0 mb-5 lg:order-2 lg:mx-0 lg:mb-0 lg:justify-self-end lg:rotate-2"
    data-reveal="pop"
    style="--reveal-delay: 120ms"
  >
    <div class="relative w-[min(62vw,235px)] lg:w-[clamp(280px,28vw,420px)]">
      <!-- Lingkaran dekoratif: sudut kiri atas -->
      <div
        class="shape-float absolute -left-9 -top-7 z-20 h-18 w-18 rotate-12 rounded-full border-[3px] border-outline bg-primary brutal-shadow-sm lg:-left-12 lg:-top-10 lg:h-32 lg:w-32 lg:brutal-shadow"
        style="--float-y: -8px; --float-duration: 6.5s; --float-delay: 0s"
        aria-hidden="true"
      >
      </div>
      <!-- Persegi dekoratif: sisi kanan, sepertiga atas -->
      <div
        class="shape-float absolute -right-7 top-16 z-20 h-14 w-14 rotate-12 border-[3px] border-outline bg-primary brutal-shadow-sm lg:-right-14 lg:top-[29%] lg:h-26 lg:w-26 lg:brutal-shadow"
        style="--float-y: -6px; --float-duration: 7.5s; --float-delay: 1.2s"
        aria-hidden="true"
      >
      </div>
      <!-- Balok dekoratif: kanan bawah -->
      <div
        class="shape-float absolute -bottom-4 -right-3 z-20 h-8 w-26 rotate-3 border-[3px] border-outline bg-primary brutal-shadow-sm lg:-right-8 lg:h-12 lg:w-48 lg:brutal-shadow"
        style="--float-y: -5px; --float-duration: 8s; --float-delay: 2.1s"
        aria-hidden="true"
      >
      </div>
      <!-- Persegi membulat dekoratif: kiri bawah -->
      <div
        class="shape-float absolute -left-7 bottom-8 z-20 h-11 w-17 -rotate-12 rounded-xl border-[3px] border-outline bg-primary lg:-left-12 lg:bottom-12 lg:h-16 lg:w-24 lg:-rotate-20 lg:rounded-2xl lg:brutal-shadow"
        style="--float-y: -7px; --float-duration: 6s; --float-delay: 0.6s"
        aria-hidden="true"
      >
      </div>

      <!-- Kartu utama: dot-grid + sudut membulat -->
      <div
        class="dot-grid brutal-border brutal-shadow relative z-10 aspect-square w-full overflow-hidden rounded-se-4xl rounded-es-4xl bg-surface -rotate-1 lg:aspect-[21/26] lg:max-h-[calc(91dvh_-_8rem)]"
      >
        <picture>
          <source srcset="/profil.webp" type="image/webp" />
          <img
            alt={name}
            src={photo}
            width="420"
            height="520"
            fetchpriority="high"
            class="relative z-10 h-full w-full object-cover object-top contrast-125 lg:object-center lg:grayscale lg:transition-all lg:duration-300 lg:hover:grayscale-0"
          />
        </picture>
      </div>
    </div>
  </div>

  <!-- Kolom teks -->
  <div
    class="relative z-20 flex w-full min-w-0 flex-col items-center gap-5 text-center [container-type:inline-size] lg:items-start lg:gap-6 lg:text-left"
  >
    <!-- Badge status (disembunyikan di mobile) -->
    <div
      class="relative z-20 hidden flex-wrap items-center justify-center gap-2.5 md:flex lg:justify-start"
      data-reveal="up"
      style="--reveal-delay: 80ms"
    >
      <span
        class="inline-flex items-center gap-2 bg-accent-yellow px-3 py-1.5 font-label-mono text-[11px] font-bold uppercase tracking-[0.12em] text-on-surface brutal-border shadow-[3px_3px_0_0_var(--color-outline)]"
      >
        <span
          class="h-2.5 w-2.5 shrink-0 rounded-full bg-[#34d399]"
          aria-hidden="true"></span>
        System_Ready // 2026
      </span>
      <span
        class="inline-flex items-center gap-1.5 bg-surface px-3 py-1.5 font-label-mono text-[11px] font-bold uppercase tracking-[0.12em] text-on-surface brutal-border shadow-[3px_3px_0_0_var(--color-outline)]"
      >
        <span aria-hidden="true">&raquo;</span>
        Portfolio_OS_V3.2
      </span>
    </div>

    <h1
      class="text-[clamp(40px,11.5vw,76px)] font-black uppercase leading-[0.98] text-on-surface relative z-20"
      data-reveal="up"
      style="--reveal-delay: 140ms"
    >
      <span class="block">Muhammad</span>
      <span class="block text-primary">Rafly</span>
      <span
        class="mt-2 inline-block bg-primary px-4 py-1.5 text-on-primary -rotate-1 brutal-border brutal-shadow"
      >
        Wirayudha
      </span>
    </h1>

    <!-- Role -->
    <p
      class="relative z-20 inline-flex items-center gap-2 bg-accent-lavender-deep px-3 py-1.5 text-center font-label-mono text-[15px] font-bold uppercase tracking-[0.14em] text-on-surface brutal-border shadow-[3px_3px_0_0_var(--color-outline)] sm:text-[11px] md:text-[32px] lg:text-left"
      data-reveal="up"
      style="--reveal-delay: 200ms"
    >
      <span
        class="h-3 w-3 shrink-0 rounded-full bg-[#34d399]"
        aria-hidden="true"></span>
      <span>[ {role} ]</span>
    </p>

    <!-- Ringkasan -->
    <p
      class="hidden relative z-20 max-w-[52ch] text-[15px] leading-relaxed text-on-surface md:text-[16px]"
      data-reveal="up"
      style="--reveal-delay: 240ms"
    >
      Undergraduate engineer bridging
      <span class="bg-accent-yellow px-1 py-0.5 font-semibold">
        Full-Stack Systems
      </span>
      <span class="mx-1">and</span>
      <span class="border-2 border-outline px-1 py-0.5 font-semibold">
        Cyber Defense
      </span>. Designing resilient, high-speed interfaces with zero-compromise
      application security.
    </p>

    <div
      class="relative z-20 mt-1 flex w-full flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4 lg:mt-2 lg:w-auto lg:justify-start"
      data-reveal="up"
      style="--reveal-delay: 300ms"
    >
      <a
        href="#projects"
        class="bg-surface text-on-surface px-7 py-3.5 w-full max-w-xs sm:w-auto sm:max-w-none brutal-border brutal-shadow transition-neobrutal brutal-hover font-label-mono text-label-mono uppercase text-center flex items-center justify-center gap-2 whitespace-nowrap"
      >
        Lihat Proyek
        <span class="material-symbols-outlined text-[18px]" aria-hidden="true">
          north_east
        </span>
      </a>
      <a
        id="cv-trigger"
        href="/cv_muhammad-rafly-wirayudha.pdf"
        target="_blank"
        rel="noopener noreferrer"
        aria-haspopup="dialog"
        class="bg-primary text-on-primary px-7 py-3.5 w-full max-w-xs sm:w-auto sm:max-w-none brutal-border brutal-shadow transition-neobrutal brutal-hover font-label-mono text-label-mono uppercase text-center flex items-center justify-center gap-2 whitespace-nowrap"
      >
        Lihat CV
        <span class="material-symbols-outlined text-[18px]" aria-hidden="true">
          visibility
        </span>
      </a>
    </div>
  </div>
</section>

<dialog
  id="cv-dialog"
  aria-labelledby="cv-dialog-title"
  class="w-[min(94vw,72rem)] max-w-none h-[92dvh] max-h-[92dvh] p-0 m-auto bg-surface brutal-border brutal-shadow text-on-surface backdrop:bg-black/80"
>
  <div class="flex h-full flex-col">
    <div
      class="flex flex-col gap-3 border-b-[3px] border-outline bg-background px-5 py-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4"
    >
      <div class="flex min-w-0 flex-col gap-1">
        <span
          class="font-label-mono text-[11px] font-bold uppercase text-on-surface-variant"
        >
          Curriculum Vitae
        </span>
        <h2
          id="cv-dialog-title"
          class="text-[17px] font-black uppercase leading-tight md:text-[22px]"
        >
          Muhammad Rafly Wirayudha
        </h2>
      </div>

      <div class="flex shrink-0 items-center gap-2">
        <a
          id="cv-dialog-download"
          href="/cv_muhammad-rafly-wirayudha.pdf"
          download="cv_muhammad-rafly-wirayudha.pdf"
          class="bg-primary text-on-primary brutal-border brutal-shadow-sm brutal-hover transition-neobrutal px-3 py-1 font-label-mono text-[11px] font-bold uppercase"
        >
          Unduh
        </a>
        <a
          id="cv-dialog-newtab"
          href="/cv_muhammad-rafly-wirayudha.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden bg-surface brutal-border brutal-shadow-sm brutal-hover transition-neobrutal px-3 py-1 font-label-mono text-[11px] font-bold uppercase sm:block"
        >
          Tab Baru
        </a>
        <button
          type="button"
          id="cv-dialog-close"
          class="shrink-0 cursor-pointer bg-surface brutal-border brutal-shadow-sm brutal-hover transition-neobrutal px-3 py-1 font-label-mono text-[11px] font-bold uppercase"
        >
          Tutup
        </button>
      </div>
    </div>

    <div
      class="min-h-0 flex-1 overflow-y-auto bg-surface-container-high p-3 md:p-4"
    >
      <iframe
        id="cv-dialog-frame"
        title="Pratinjau CV Muhammad Rafly Wirayudha"
        class="hidden h-full w-full bg-surface brutal-border"></iframe>

      <div id="cv-dialog-fallback" class="hidden h-full">
        <div
          class="flex h-full flex-col items-center justify-center gap-4 px-2 py-8 text-center"
        >
          <span
            class="material-symbols-outlined text-[40px] text-on-surface-variant"
            aria-hidden="true"
          >
            description
          </span>
          <p
            class="font-label-mono text-[11px] font-bold uppercase text-on-surface-variant"
          >
            Browser ini belum mendukung pratinjau PDF langsung
          </p>
          <p class="max-w-[42ch] text-[15px] leading-relaxed text-on-surface">
            Buka CV di tab baru atau unduh filenya untuk melihat isinya.
          </p>
          <div
            class="flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row"
          >
            <a
              id="cv-dialog-fallback-open"
              href="/cv_muhammad-rafly-wirayudha.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-primary text-on-primary px-6 py-3 brutal-border brutal-shadow transition-neobrutal brutal-hover font-label-mono text-label-mono uppercase text-center flex items-center justify-center gap-2"
            >
              Buka CV
              <span
                class="material-symbols-outlined text-[18px]"
                aria-hidden="true">open_in_new</span
              >
            </a>
            <a
              id="cv-dialog-fallback-download"
              href="/cv_muhammad-rafly-wirayudha.pdf"
              download="cv_muhammad-rafly-wirayudha.pdf"
              class="bg-surface text-on-surface px-6 py-3 brutal-border brutal-shadow transition-neobrutal brutal-hover font-label-mono text-label-mono uppercase text-center flex items-center justify-center gap-2"
            >
              Unduh CV
              <span
                class="material-symbols-outlined text-[18px]"
                aria-hidden="true">download</span
              >
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  // Pause animasi shape saat Hero tidak terlihat (hemat CPU/baterai)
  const hero = document.getElementById("hero");
  const heroShapes = hero?.querySelectorAll<HTMLElement>(".shape-float");

  if (hero && heroShapes && heroShapes.length > 0) {
    const shapeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          hero.classList.toggle("shapes-paused", !entry.isIntersecting);
        });
      },
      { threshold: 0 },
    );

    shapeObserver.observe(hero);
  }

  // ==== Pratinjau CV (dialog) ====
  const cvTrigger = document.getElementById("cv-trigger");
  const cvDialog = document.getElementById(
    "cv-dialog",
  ) as HTMLDialogElement | null;
  const cvFrame = document.getElementById(
    "cv-dialog-frame",
  ) as HTMLIFrameElement | null;
  const cvFallback = document.getElementById("cv-dialog-fallback");
  const cvDownload = document.getElementById(
    "cv-dialog-download",
  ) as HTMLAnchorElement | null;
  const cvNewTab = document.getElementById(
    "cv-dialog-newtab",
  ) as HTMLAnchorElement | null;
  const cvClose = document.getElementById("cv-dialog-close");

  if (cvTrigger && cvDialog && cvFrame && cvFallback) {
    const cvUrl = cvTrigger.getAttribute("href") ?? "";

    // Sinkronkan tautan unduh/buka supaya sumbernya tetap satu (href tombol hero)
    cvDownload?.setAttribute("href", cvUrl);
    cvNewTab?.setAttribute("href", cvUrl);

    // iOS/iPadOS tidak mendukung pratinjau PDF inline di iframe
    const isIOS =
      /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.maxTouchPoints > 1 && /Macintosh/.test(navigator.userAgent));
    const canEmbedPdf =
      !isIOS &&
      (navigator as Navigator & { pdfViewerEnabled?: boolean })
        .pdfViewerEnabled !== false;

    const openCvDialog = () => {
      if (canEmbedPdf && !cvFrame.getAttribute("src")) {
        cvFrame.src = `${cvUrl}#view=FitH&navpanes=0&toolbar=1`;
      }

      cvFrame.classList.toggle("hidden", !canEmbedPdf);
      cvFallback.classList.toggle("hidden", canEmbedPdf);

      cvDialog.showModal();
    };

    cvTrigger.addEventListener("click", (event) => {
      // Biarkan perilaku bawaan (buka tab baru) bila JS gagal
      event.preventDefault();
      openCvDialog();
    });

    cvClose?.addEventListener("click", () => cvDialog.close());

    // Tutup saat klik area gelap di luar panel
    cvDialog.addEventListener("click", (event) => {
      if (event.target !== cvDialog) return;

      const rect = cvDialog.getBoundingClientRect();
      const isInsidePanel =
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom;

      if (!isInsidePanel) cvDialog.close();
    });
  }
</script>
