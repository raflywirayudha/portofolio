---
import SectionHeader from "./SectionHeader.astro";
import { education } from "../data/education";
---

<section
  id="education"
  class="w-full flex flex-col gap-8 border-t-[3px] border-outline py-10 px-margin-mobile md:px-margin-desktop dot-grid-lavender"
>
  <SectionHeader label="education" title="Education" />
  <div class="relative flex flex-col gap-10 py-4">
    <div
      class="absolute left-[13px] top-0 bottom-4 w-[3px] bg-outline"
      aria-hidden="true"
      data-reveal="grow"
    >
    </div>
    {
      education.map((item, index) => (
        <div class="relative pl-10 md:pl-14">
          <span
            class:list={[
              "absolute left-[2px] top-6 md:top-11 z-10 flex h-6 w-6 items-center justify-center rounded-full border-[3px] border-outline",
              item.featured ? "bg-primary" : "bg-accent-yellow",
            ]}
            aria-hidden="true"
            data-reveal="pop"
            style={`--reveal-delay: ${index * 120}ms`}
          >
            <span
              class:list={[
                "h-2 w-2 rounded-full",
                item.featured ? "bg-accent-lavender" : "bg-outline",
              ]}
            />
          </span>

          <article
            class="bg-accent-lavender brutal-border brutal-shadow p-5 md:p-8 flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between lg:gap-8"
            data-reveal="up"
            style={`--reveal-delay: ${index * 120}ms`}
          >
            <div class="flex min-w-0 flex-col gap-3">
              <span
                class:list={[
                  "font-label-mono text-[12px] font-bold uppercase tracking-[0.1em] self-start px-3 py-1.5 shadow-[3px_3px_0_0_var(--color-outline)]",
                  item.featured
                    ? "bg-primary text-on-primary"
                    : "bg-accent-lavender-deep text-on-surface",
                ]}
              >
                {item.period}
              </span>
              <h3 class="text-[26px] md:text-[36px] font-black uppercase leading-[1.05] tracking-tight text-on-surface">
                {item.school}
              </h3>
              <p class="font-label-mono text-[13px] md:text-[14px] font-bold uppercase tracking-[0.16em] text-primary">
                {item.major}
              </p>
            </div>
          </article>
        </div>
      ))
    }
  </div>
</section>
